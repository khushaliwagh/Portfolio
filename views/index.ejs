<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khushali Wagh | Full Stack Java Developer & Software Engineer</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- AOS (Animate on Scroll) -->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">

    <!-- Custom CSS -->
    <style>
        :root {
            --bg-dark: #020617;
            --bg-card: rgba(15, 23, 42, 0.7);
            --border-card: #1f2937;
            --primary-blue: #3b82f6;
            --primary-hover: #2563eb;
            --accent-glow: rgba(59, 130, 246, 0.4);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-dark);
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        /* ---------------- COMMON & GLOW ---------------- */
        .neon-border {
            border: 1px solid rgba(59, 130, 246, 0.3);
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.35);
        }

        .card-dark {
            background: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: 18px;
            backdrop-filter: blur(12px);
            transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .card-dark:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: rgba(59, 130, 246, 0.7);
            box-shadow: 0 15px 35px rgba(59, 130, 246, 0.25), 0 0 15px rgba(59, 130, 246, 0.2);
        }

        /* ---------------- NAVBAR ---------------- */
        .navbar-custom {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s;
        }

        .navbar-nav .nav-link {
            color: #e2e8f0;
            font-weight: 500;
            padding: 8px 16px;
            position: relative;
            transition: 0.3s;
        }

        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-link.active {
            color: #60a5fa;
        }

        .navbar-nav .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 2px;
            left: 16px;
            background: #3b82f6;
            transition: width 0.3s ease;
        }

        .navbar-nav .nav-link:hover::after {
            width: calc(100% - 32px);
        }

        /* ---------------- HERO ---------------- */
        .display-4 {
            animation: floatText 4s ease-in-out infinite;
            letter-spacing: -1px;
        }

        @keyframes floatText {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            border: none;
            padding: 12px 28px;
            border-radius: 12px;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.6);
            background: linear-gradient(135deg, #1d4ed8, #2563eb);
        }

        .btn-outline-light {
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 12px;
            padding: 12px 28px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-outline-light:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #60a5fa;
            color: #60a5fa;
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(59, 130, 246, 0.3);
        }

        /* ---------------- FLOATING IMAGE & ICONS ---------------- */
        .floating-img {
            animation: floatImage 4s ease-in-out infinite;
            filter: drop-shadow(0 0 35px rgba(37, 99, 235, 0.45));
            border-radius: 30px;
            max-height: 440px;
            object-fit: cover;
        }

        @keyframes floatImage {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-16px); }
        }

        .glow-circle {
            position: relative;
        }

        .floating-icon {
            color: white;
            font-weight: bold;
            padding: 12px 18px;
            font-size: 20px;
            border-radius: 14px;
            background: rgba(15, 23, 42, 0.9) !important;
            border: 1px solid rgba(59, 130, 246, 0.4);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            animation: floatIcon 3.5s ease-in-out infinite;
            transition: all 0.3s ease;
            backdrop-filter: blur(8px);
        }

        .floating-icon:hover {
            transform: scale(1.25) rotate(10deg);
            background: #2563eb !important;
            box-shadow: 0 0 25px #3b82f6;
            color: white;
        }

        @keyframes floatIcon {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-14px); }
        }

        .html-icon { animation-duration: 3.2s; animation-delay: 0.2s; }
        .js-icon { animation-duration: 4.1s; animation-delay: 0.5s; }
        .react-icon { animation-duration: 4.8s; animation-delay: 0.8s; }
        .java-icon { animation-duration: 5.5s; animation-delay: 1.1s; }

        .react-icon i {
            animation: spin 8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ---------------- SOCIAL ICONS ---------------- */
        .social-icons a {
            width: 48px;
            height: 48px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 50%;
            text-decoration: none;
            color: #94a3b8;
            font-size: 20px;
            transition: all 0.4s ease;
        }

        .social-icons a:hover {
            background: #3b82f6;
            color: #fff;
            transform: translateY(-8px) rotate(360deg);
            box-shadow: 0 0 20px #3b82f6;
            border-color: #3b82f6;
        }

        /* ---------------- SKILLS BARS ---------------- */
        .skill-bar {
            height: 9px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            overflow: hidden;
            position: relative;
        }

        .skill-progress {
            height: 100%;
            background: linear-gradient(90deg, #2563eb, #60a5fa);
            border-radius: 6px;
            position: relative;
            transition: width 1.2s ease-in-out;
        }

        .skill-card-badge {
            background: rgba(59, 130, 246, 0.15);
            color: #93c5fd;
            border: 1px solid rgba(59, 130, 246, 0.3);
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: 500;
        }

        /* ---------------- PROJECT CARDS ---------------- */
        .project-card-full {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid #1e293b;
            border-radius: 20px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
            transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .project-card-full:hover {
            transform: translateY(-10px);
            border-color: rgba(59, 130, 246, 0.6);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(59, 130, 246, 0.3);
        }

        .project-img-container {
            position: relative;
            height: 220px;
            overflow: hidden;
            background: #0b1120;
        }

        .project-img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .project-card-full:hover .project-img-container img {
            transform: scale(1.08);
        }

        .project-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(180deg, rgba(2,6,23,0) 40%, rgba(2,6,23,0.9) 100%);
        }

        .tech-tag {
            background: rgba(30, 41, 59, 0.8);
            color: #93c5fd;
            border: 1px solid rgba(59, 130, 246, 0.3);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 500;
            display: inline-block;
            margin: 2px;
        }

        /* ---------------- EXPERIENCE & EDUCATION TIMELINE ---------------- */
        .timeline-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid #1e293b;
            border-left: 4px solid #3b82f6;
            border-radius: 14px;
            padding: 24px;
            margin-bottom: 20px;
            transition: all 0.3s;
        }

        .timeline-card:hover {
            transform: translateX(6px);
            border-color: #60a5fa;
            box-shadow: 0 10px 25px rgba(59, 130, 246, 0.2);
        }

        /* ---------------- CTA ---------------- */
        .cta-box {
            background: linear-gradient(145deg, #071c3a, #020617);
            padding: 50px;
            border-radius: 24px;
            border: 1px solid rgba(59, 130, 246, 0.3);
            box-shadow: 0 0 35px rgba(59, 130, 246, 0.25), inset 0 0 25px rgba(59, 130, 246, 0.08);
        }

        .hire-btn {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            border: none;
            padding: 14px 36px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 16px;
            color: white;
            transition: all 0.3s;
        }

        .hire-btn:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 8px 30px rgba(59, 130, 246, 0.7);
            color: white;
        }

        /* ---------------- CONTACT ---------------- */
        .contact-container {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(15px);
            padding: 40px;
            border-radius: 22px;
            border: 1px solid rgba(59, 130, 246, 0.3);
            box-shadow: 0 0 35px rgba(59, 130, 246, 0.25);
        }

        .contact-form input,
        .contact-form textarea {
            background: rgba(255, 255, 255, 0.05);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 14px;
            border-radius: 12px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #3b82f6;
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.35);
            outline: none;
            color: white;
        }

        /* ---------------- TYPING ANIMATION ---------------- */
        .typing-cursor {
            display: inline-block;
            width: 3px;
            height: 1.1em;
            background: #3b82f6;
            margin-left: 4px;
            animation: blink 0.8s infinite;
            vertical-align: middle;
        }

        @keyframes blink {
            50% { opacity: 0; }
        }
    </style>
</head>

