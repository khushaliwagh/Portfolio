<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | Khushali Wagh Portfolio</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <style>
    .project-thumb {
      width: 65px;
      height: 50px;
      object-fit: cover;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.12);
      transition: transform 0.3s;
    }
    .project-thumb:hover {
      transform: scale(1.4);
      z-index: 10;
      position: relative;
    }
    .quick-add-card {
      border: 2px dashed #3b82f6;
      background: #f8fbff;
      border-radius: 18px;
      transition: all 0.3s;
    }
    .quick-add-card:hover {
      box-shadow: 0 10px 30px rgba(37,99,235,0.12);
    }
    .badge-pill-tech {
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #bfdbfe;
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 12px;
      display: inline-block;
      margin: 2px;
    }
  </style>
</head>

<body>

  <div class="wrapper">

    <!-- Sidebar Partial -->
    <%- include('partials/adminSidebar', { active: 'dashboard', unreadCount: stats.unreadMessages }) %>

    <!-- Main Content -->
    <div class="main">

      <!-- Navbar Partial -->
      <%- include('partials/adminNavbar', { unreadCount: stats.unreadMessages }) %>

      <!-- Alert Banners -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show mt-3 shadow-sm" role="alert">
          <i class="fas fa-check-circle me-2"></i> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show mt-3 shadow-sm" role="alert">
          <i class="fas fa-exclamation-triangle me-2"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Dashboard Stats Cards -->
      <div class="row mt-4 g-4">

        <div class="col-lg-3 col-md-6">
          <div class="dashboard-card card-blue">
            <i class="fas fa-folder"></i>
            <h2><%= stats.totalProjects %></h2>
            <p>Total Projects</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="dashboard-card card-green">
            <i class="fas fa-envelope"></i>
            <h2><%= stats.totalMessages %></h2>
            <p>Total Messages</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="dashboard-card card-orange">
            <i class="fas fa-bell"></i>
            <h2><%= stats.unreadMessages %></h2>
            <p>Unread Messages</p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <div class="dashboard-card card-purple">
            <i class="fas fa-code"></i>
            <h2><%= stats.totalSkills %></h2>
            <p>Technical Skills</p>
          </div>
        </div>

      </div>

      <!-- Quick Action Buttons -->
      <div class="row mt-4 g-3">
        <div class="col-md-3">
          <button class="btn btn-primary w-100 py-3 shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#quickAddProjectForm" aria-expanded="false">
            <i class="fas fa-plus-circle me-2"></i> Add Project on Dashboard
          </button>
        </div>
        <div class="col-md-3">
          <a href="/admin/projects" class="btn btn-outline-primary w-100 py-3 shadow-sm">
            <i class="fas fa-folder-open me-2"></i> Manage All Projects
          </a>
        </div>
        <div class="col-md-3">
          <a href="/admin/messages" class="btn btn-outline-success w-100 py-3 shadow-sm">
            <i class="fas fa-inbox me-2"></i> View All Messages
          </a>
        </div>
        <div class="col-md-3">
          <a href="/" target="_blank" class="btn btn-dark w-100 py-3 shadow-sm">
            <i class="fas fa-globe me-2"></i> Open Live Portfolio
          </a>
        </div>
      </div>

      <!-- Add Project on Dashboard (Collapsible & Functional) -->
      <div class="collapse mt-4 show" id="quickAddProjectForm">
        <div class="card p-4 quick-add-card shadow-sm">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0 text-primary fw-bold">
              <i class="fas fa-plus-circle me-2"></i> Add Project to Portfolio
            </h4>
            <span class="text-muted small">Adds project directly into MySQL and displays on live site</span>
          </div>

          <form action="/admin/projects/add" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Project Title <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="fas fa-heading text-primary"></i></span>
                  <input type="text" name="title" class="form-control" placeholder="e.g. Full-Stack E-Commerce Application" required>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-semibold">Technologies / Tech Stack <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="fas fa-code text-primary"></i></span>
                  <input type="text" name="technology" class="form-control" placeholder="e.g. Java, Spring Boot, React.js, MySQL" required>
                </div>
              </div>

              <div class="col-12">
                <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                <textarea name="description" class="form-control" rows="3" placeholder="Detailed description of features, architecture, and deployment..." required></textarea>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">GitHub Repository Link</label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="fab fa-github text-dark"></i></span>
                  <input type="url" name="github" class="form-control" placeholder="https://github.com/khushaliwagh/...">
                </div>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">Live Demo Link</label>
                <div class="input-group">
                  <span class="input-group-text bg-white"><i class="fas fa-globe text-success"></i></span>
                  <input type="url" name="demo" class="form-control" placeholder="https://...">
                </div>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-semibold">Project Image / Screenshot</label>
                <input type="file" name="image" class="form-control" id="dashboardImageUpload" accept="image/*">
                <div class="form-text">Optional; default screenshot applied if omitted</div>
              </div>

              <div class="col-12 text-end mt-3">
                <button type="submit" class="btn btn-primary px-4 py-2">
                  <i class="fas fa-save me-2"></i> Save & Publish Project
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Manage Projects Table on Dashboard (CRUD) -->
      <div class="card mt-4 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="mb-0 fw-bold">
            <i class="fas fa-folder-open text-primary me-2"></i> Projects in Portfolio
          </h4>
          <a href="/admin/projects/add" class="btn btn-sm btn-primary">
            <i class="fas fa-plus me-1"></i> Add Project
          </a>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th style="width: 80px;">Image</th>
                <th>Title</th>
                <th>Technologies</th>
                <th>Links</th>
                <th class="text-center" style="width: 160px;">Actions (CRUD)</th>
              </tr>
            </thead>
            <tbody>
              <% if (projects && projects.length > 0) { %>
                <% projects.forEach(project => { %>
                  <tr>
                    <td>
                      <img src="/uploads/projects/<%= project.image %>" class="project-thumb" alt="<%= project.title %>" onerror="this.onerror=null;this.src='/images/webs.png';">
                    </td>
                    <td>
                      <strong class="d-block text-dark"><%= project.title %></strong>
                      <small class="text-muted"><%= (project.description || '').substring(0, 90) %>...</small>
                    </td>
                    <td>
                      <% if (project.technology) { %>
                        <% project.technology.split(',').slice(0, 4).forEach(t => { %>
                          <span class="badge-pill-tech"><%= t.trim() %></span>
                        <% }) %>
                      <% } %>
                    </td>
                    <td>
                      <% if (project.github) { %>
                        <a href="<%= project.github %>" target="_blank" class="btn btn-sm btn-outline-dark me-1" title="GitHub">
                          <i class="fab fa-github"></i>
                        </a>
                      <% } %>
                      <% if (project.demo) { %>
                        <a href="<%= project.demo %>" target="_blank" class="btn btn-sm btn-outline-success" title="Live Demo">
                          <i class="fas fa-external-link-alt"></i>
                        </a>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <div class="btn-group btn-group-sm">
                        <a href="/admin/projects/edit/<%= project.id %>" class="btn btn-warning" title="Edit Project">
                          <i class="fas fa-edit"></i> Edit
                        </a>
                        <a href="/admin/projects/delete/<%= project.id %>" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this project?')" title="Delete Project">
                          <i class="fas fa-trash"></i> Delete
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">
                    No projects found. Use the form above to add your first project!
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Contact Messages -->
      <div class="card mt-4 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h4 class="mb-0 fw-bold">
            <i class="fas fa-envelope-open-text text-success me-2"></i> Recent Contact Messages
          </h4>
          <a href="/admin/messages" class="btn btn-sm btn-outline-secondary">
            View All (<%= stats.totalMessages %>)
          </a>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Message Preview</th>
                <th>Status</th>
                <th>Date</th>
                <th class="text-center" style="width: 140px;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (messages && messages.length > 0) { %>
                <% messages.slice(0, 5).forEach(msg => { %>
                  <tr>
                    <td class="fw-semibold"><%= msg.name %></td>
                    <td>
                      <a href="mailto:<%= msg.email %>" class="text-decoration-none text-muted">
                        <%= msg.email %>
                      </a>
                    </td>
                    <td>
                      <small class="text-muted"><%= (msg.message || '').substring(0, 60) %>...</small>
                    </td>
                    <td>
                      <% if (msg.status === 'Unread') { %>
                        <span class="badge bg-danger">New / Unread</span>
                      <% } else { %>
                        <span class="badge bg-success">Read</span>
                      <% } %>
                    </td>
                    <td>
                      <small class="text-muted"><%= new Date(msg.created_at).toLocaleDateString() %></small>
                    </td>
                    <td class="text-center">
                      <div class="btn-group btn-group-sm">
                        <a href="/admin/messages/view/<%= msg.id %>" class="btn btn-primary" title="View Message">
                          <i class="fas fa-eye"></i>
                        </a>
                        <a href="/admin/messages/delete/<%= msg.id %>" class="btn btn-danger" onclick="return confirm('Delete this message?')" title="Delete">
                          <i class="fas fa-trash"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">No contact messages received yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Skills Progress Overview -->
      <div class="card mt-4 p-4 shadow-sm">
        <h4 class="fw-bold mb-3"><i class="fas fa-chart-bar text-warning me-2"></i> Key Technical Skills Overview</h4>
        <div class="row g-3">
          <div class="col-md-6">
            <div class="d-flex justify-content-between mb-1">
              <span>Java & Core Java</span>
              <span class="fw-bold text-primary">90%</span>
            </div>
            <div class="progress mb-3" style="height: 10px;">
              <div class="progress-bar bg-primary" style="width: 90%"></div>
            </div>

            <div class="d-flex justify-content-between mb-1">
              <span>Spring Boot & REST APIs</span>
              <span class="fw-bold text-success">85%</span>
            </div>
            <div class="progress mb-3" style="height: 10px;">
              <div class="progress-bar bg-success" style="width: 85%"></div>
            </div>

            <div class="d-flex justify-content-between mb-1">
              <span>React.js & Redux Toolkit</span>
              <span class="fw-bold text-info">85%</span>
            </div>
            <div class="progress mb-3" style="height: 10px;">
              <div class="progress-bar bg-info" style="width: 85%"></div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="d-flex justify-content-between mb-1">
              <span>MySQL Database & SQL</span>
              <span class="fw-bold text-warning">80%</span>
            </div>
            <div class="progress mb-3" style="height: 10px;">
              <div class="progress-bar bg-warning" style="width: 80%"></div>
            </div>

            <div class="d-flex justify-content-between mb-1">
              <span>JavaScript & Node.js</span>
              <span class="fw-bold" style="color:#7c3aed;">80%</span>
            </div>
            <div class="progress mb-3" style="height: 10px;">
              <div class="progress-bar" style="background:#7c3aed; width: 80%"></div>
            </div>

            <div class="d-flex justify-content-between mb-1">
              <span>Android Development (Java/XML)</span>
              <span class="fw-bold text-danger">75%</span>
            </div>
            <div class="progress mb-3" style="height: 10px;">
              <div class="progress-bar bg-danger" style="width: 75%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer Partial -->
      <%- include('partials/adminFooter') %>

    </div>

  </div>

</body>

</html>
