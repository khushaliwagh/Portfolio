<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Khushali Wagh Portfolio</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

  <style>
    body {
      background: #020617;
      color: white;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Inter', system-ui, sans-serif;
      padding: 20px;
    }

    .login-box {
      background: #0f172a;
      padding: 40px;
      border-radius: 20px;
      border: 1px solid rgba(59, 130, 246, 0.3);
      width: 100%;
      max-width: 400px;
      box-shadow: 0 0 30px rgba(59, 130, 246, 0.25);
      animation: fadeIn 0.6s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .form-control {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid #1e293b;
      color: white;
      padding: 12px 16px;
      border-radius: 12px;
    }

    .form-control:focus {
      background: rgba(255, 255, 255, 0.08);
      border-color: #3b82f6;
      color: white;
      box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
    }

    .btn-primary {
      background: linear-gradient(135deg, #2563eb, #3b82f6);
      border: none;
      padding: 12px;
      border-radius: 12px;
      font-weight: 600;
      transition: all 0.3s;
    }

    .btn-primary:hover {
      box-shadow: 0 0 20px rgba(59, 130, 246, 0.6);
      transform: translateY(-2px);
    }

    .demo-pill {
      background: rgba(59, 130, 246, 0.1);
      border: 1px dashed rgba(59, 130, 246, 0.4);
      padding: 10px;
      border-radius: 10px;
      font-size: 13px;
      color: #93c5fd;
    }
  </style>
</head>

<body>

<div class="login-box">
  <div class="text-center mb-4">
    <div style="font-size: 40px; margin-bottom: 10px;">🔐</div>
    <h3 class="fw-bold mb-1">Admin Login</h3>
    <p class="text-secondary small">Portfolio Management System</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger py-2" style="font-size: 14px;"><i class="fas fa-exclamation-circle me-1"></i> <%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success py-2" style="font-size: 14px;"><i class="fas fa-check-circle me-1"></i> <%= success %></div>
  <% } %>

  <form action="/login" method="POST">
    <div class="mb-3">
      <label class="form-label small text-secondary">Username or Email</label>
      <input type="text" name="username" class="form-control" placeholder="admin or email" value="admin" required>
    </div>

    <div class="mb-3">
      <label class="form-label small text-secondary">Password</label>
      <input type="password" name="password" class="form-control" placeholder="••••••••" value="admin123" required>
    </div>

    <button type="submit" class="btn btn-primary w-100 mt-2 mb-3">
      <i class="fas fa-sign-in-alt me-1"></i> Login to Dashboard
    </button>
  </form>

  <div class="demo-pill mb-3 text-center">
    <div><strong>Demo Admin Credentials:</strong></div>
    <div>Username: <code>admin</code> | Password: <code>admin123</code></div>
  </div>

  <div class="d-flex justify-content-between align-items-center text-secondary small pt-2 border-top border-secondary-subtle">
    <a href="/" class="text-secondary text-decoration-none">
      <i class="fas fa-arrow-left me-1"></i> Back to Portfolio
    </a>
    <a href="/signup" class="text-primary text-decoration-none">
      Register Account
    </a>
  </div>
</div>

</body>
</html>
