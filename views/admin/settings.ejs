<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body>
    <div class="wrapper">

        <!-- Sidebar Partial -->
        <%- include('../partials/adminSidebar', { active: 'settings' }) %>

        <!-- Main -->
        <div class="main">

            <!-- Navbar Partial -->
            <%- include('../partials/adminNavbar') %>

            <div class="container-fluid mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-cog text-primary me-2"></i> System & Admin Settings
                        </h2>
                        <p class="text-muted mb-0">Manage admin credentials, security, and portfolio settings</p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Change Password -->
                    <div class="col-lg-6">
                        <div class="card p-4 shadow-sm border-0">
                            <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-key me-1"></i> Change Admin Password</h5>
                            <form action="/admin/settings/password" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Current Username</label>
                                    <input type="text" class="form-control bg-light" value="<%= user ? user.username : 'admin' %>" readonly>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">New Password</label>
                                    <input type="password" name="newPassword" class="form-control" placeholder="Enter new strong password" required minlength="4">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Confirm New Password</label>
                                    <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm new password" required minlength="4">
                                </div>
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-lock me-1"></i> Update Password
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- System Info -->
                    <div class="col-lg-6">
                        <div class="card p-4 shadow-sm border-0">
                            <h5 class="fw-bold mb-3 text-secondary"><i class="fas fa-server me-1"></i> System Information</h5>
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>Application Name</span>
                                    <strong>Khushali Wagh Portfolio & CMS</strong>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>Backend Environment</span>
                                    <span class="badge bg-success">Node.js + Express.js</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>Database</span>
                                    <span class="badge bg-primary">MySQL 8.0 (Localhost)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>View Engine</span>
                                    <span class="badge bg-warning text-dark">EJS (Embedded JavaScript)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>Default Admin Login</span>
                                    <code>admin / admin123</code>
                                </li>
                            </ul>

                            <div class="mt-4 pt-3 border-top d-flex gap-2">
                                <a href="/" target="_blank" class="btn btn-outline-primary flex-grow-1">
                                    <i class="fas fa-globe me-1"></i> Visit Website
                                </a>
                                <a href="/logout" class="btn btn-outline-danger">
                                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Partial -->
            <%- include('../partials/adminFooter') %>

        </div>
    </div>
</body>

</html>
