<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Projects | Admin Dashboard</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <!-- Admin CSS -->
    <link rel="stylesheet" href="/css/admin.css">

    <style>
        .project-img {
            width: 80px;
            height: 60px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        .project-img:hover {
            transform: scale(1.3);
            position: relative;
            z-index: 10;
        }
        .tech-pill {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 12px;
            display: inline-block;
            margin: 2px;
        }
    </style>
</head>

<body>
    <div class="wrapper">

        <!-- Sidebar Partial -->
        <%- include('../partials/adminSidebar', { active: 'projects' }) %>

        <!-- Main -->
        <div class="main">

            <!-- Navbar Partial -->
            <%- include('../partials/adminNavbar') %>

            <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                <div>
                    <h2 class="fw-bold mb-1">
                        <i class="fas fa-folder-open text-primary me-2"></i> Manage Projects
                    </h2>
                    <p class="text-muted mb-0">Add, edit, or delete portfolio projects</p>
                </div>

                <a href="/admin/projects/add" class="btn btn-primary shadow-sm">
                    <i class="fas fa-plus me-1"></i> Add New Project
                </a>
            </div>

            <!-- Projects Table Card -->
            <div class="card p-4 shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 100px;">Screenshot</th>
                                <th>Project Details</th>
                                <th>Tech Stack</th>
                                <th>Live / GitHub</th>
                                <th class="text-center" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% if (projects && projects.length > 0) { %>
                                <% projects.forEach(project => { %>
                                    <tr>
                                        <td>
                                            <img src="/uploads/projects/<%= project.image %>" class="project-img" alt="<%= project.title %>" onerror="this.onerror=null;this.src='/images/webs.png';">
                                        </td>

                                        <td>
                                            <h6 class="fw-bold mb-1 text-dark"><%= project.title %></h6>
                                            <small class="text-muted" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                                                <%= project.description %>
                                            </small>
                                        </td>

                                        <td>
                                            <% if (project.technology) { %>
                                                <% project.technology.split(',').forEach(tech => { %>
                                                    <span class="tech-pill"><%= tech.trim() %></span>
                                                <% }) %>
                                            <% } %>
                                        </td>

                                        <td>
                                            <div class="d-flex gap-2">
                                                <% if (project.github) { %>
                                                    <a href="<%= project.github %>" target="_blank" class="btn btn-sm btn-outline-dark" title="GitHub Repo">
                                                        <i class="fab fa-github"></i>
                                                    </a>
                                                <% } %>
                                                <% if (project.demo) { %>
                                                    <a href="<%= project.demo %>" target="_blank" class="btn btn-sm btn-outline-success" title="Live Demo">
                                                        <i class="fas fa-external-link-alt"></i>
                                                    </a>
                                                <% } %>
                                            </div>
                                        </td>

                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a href="/admin/projects/edit/<%= project.id %>" class="btn btn-warning btn-sm" title="Edit Project">
                                                    <i class="fas fa-edit me-1"></i> Edit
                                                </a>
                                                <a href="/admin/projects/delete/<%= project.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this project?')" title="Delete Project">
                                                    <i class="fas fa-trash me-1"></i> Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="fas fa-folder-open fa-3x mb-3 text-secondary"></i>
                                        <p>No projects found. Click "Add New Project" above to create one!</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer Partial -->
            <%- include('../partials/adminFooter') %>

        </div>
    </div>
</body>

</html>
