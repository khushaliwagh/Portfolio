<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Message | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body>
    <div class="wrapper">

        <!-- Sidebar Partial -->
        <%- include('../partials/adminSidebar', { active: 'messages' }) %>

        <!-- Main -->
        <div class="main">

            <!-- Navbar Partial -->
            <%- include('../partials/adminNavbar') %>

            <div class="container-fluid mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-envelope-open text-primary me-2"></i> Message Details
                        </h2>
                        <p class="text-muted mb-0">Message sent from your portfolio contact form</p>
                    </div>

                    <a href="/admin/messages" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Messages
                    </a>
                </div>

                <div class="card p-4 shadow-sm border-0">
                    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                        <div>
                            <h4 class="fw-bold text-dark mb-1"><%= message.name %></h4>
                            <p class="text-muted mb-0">
                                <i class="fas fa-envelope me-1 text-primary"></i>
                                <a href="mailto:<%= message.email %>" class="text-decoration-none"><%= message.email %></a>
                            </p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-success mb-2">Read</span>
                            <div class="small text-muted">
                                <i class="fas fa-clock me-1"></i> <%= new Date(message.created_at).toLocaleString() %>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary mb-2">Message Content:</h6>
                    <div class="p-4 bg-light rounded-3 mb-4" style="white-space: pre-line; line-height: 1.7; font-size: 15px;">
                        <%= message.message %>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="mailto:<%= message.email %>?subject=Re:%20Portfolio%20Inquiry" class="btn btn-primary px-4">
                            <i class="fas fa-reply me-1"></i> Reply via Email
                        </a>

                        <a href="/admin/messages/delete/<%= message.id %>" class="btn btn-outline-danger" onclick="return confirm('Delete this message?')">
                            <i class="fas fa-trash me-1"></i> Delete Message
                        </a>
                    </div>
                </div>
            </div>

            <!-- Footer Partial -->
            <%- include('../partials/adminFooter') %>

        </div>
    </div>
</body>

</html>
