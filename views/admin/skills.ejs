<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Skills | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body>
    <div class="wrapper">

        <!-- Sidebar Partial -->
        <%- include('../partials/adminSidebar', { active: 'skills' }) %>

        <!-- Main -->
        <div class="main">

            <!-- Navbar Partial -->
            <%- include('../partials/adminNavbar') %>

            <div class="container-fluid mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-code text-primary me-2"></i> Manage Skills
                        </h2>
                        <p class="text-muted mb-0">Manage technical skills and proficiency percentages</p>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Add Skill Form -->
                    <div class="col-lg-4">
                        <div class="card p-4 shadow-sm border-0">
                            <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-plus-circle me-1"></i> Add New Skill</h5>
                            <form action="/admin/skills/add" method="POST">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Skill Name</label>
                                    <input type="text" name="name" class="form-control" placeholder="e.g. Spring Boot" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Category</label>
                                    <select name="category" class="form-select" required>
                                        <option value="Backend">Backend</option>
                                        <option value="Frontend">Frontend</option>
                                        <option value="Database">Database</option>
                                        <option value="Tools">Tools & Deployment</option>
                                        <option value="Mobile">Mobile Development</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Proficiency Level (%)</label>
                                    <input type="number" name="level" class="form-control" min="10" max="100" value="85" required>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-save me-1"></i> Add Skill
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Skills Table -->
                    <div class="col-lg-8">
                        <div class="card p-4 shadow-sm border-0">
                            <h5 class="fw-bold mb-3"><i class="fas fa-list me-1 text-secondary"></i> Existing Skills</h5>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Skill Name</th>
                                            <th>Category</th>
                                            <th style="width: 180px;">Proficiency</th>
                                            <th class="text-center" style="width: 80px;">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% if (skills && skills.length > 0) { %>
                                            <% skills.forEach(skill => { %>
                                                <tr>
                                                    <td><strong><%= skill.name %></strong></td>
                                                    <td><span class="badge bg-secondary-subtle text-secondary"><%= skill.category %></span></td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                                <div class="progress-bar bg-primary" style="width: <%= skill.level %>%"></div>
                                                            </div>
                                                            <small class="text-muted"><%= skill.level %>%</small>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="/admin/skills/delete/<%= skill.id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this skill?')">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">No skills registered yet.</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Partial -->
            <%- include('../partials/adminFooter') %>

        </div>
    </div>
</body>

</html>
