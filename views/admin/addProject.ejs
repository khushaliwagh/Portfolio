<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Project | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <style>
        .form-card {
            background: white;
            border-radius: 20px;
            padding: 35px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .upload-area {
            border: 2px dashed #3b82f6;
            background: #f8fbff;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .upload-area:hover {
            background: #eff6ff;
        }

        #preview {
            max-width: 250px;
            max-height: 180px;
            object-fit: cover;
            border-radius: 12px;
            margin-top: 15px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            display: none;
        }
    </style>
</head>

<body>
    <div class="wrapper">

        <!-- Sidebar Partial -->
        <%- include('../partials/adminSidebar', { active: 'add-project' }) %>

        <!-- Main -->
        <div class="main">

            <!-- Navbar Partial -->
            <%- include('../partials/adminNavbar') %>

            <div class="container-fluid mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-folder-plus text-primary me-2"></i> Add New Project
                        </h2>
                        <p class="text-muted mb-0">Create and publish a new project into your portfolio</p>
                    </div>

                    <a href="/admin/projects" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to Projects
                    </a>
                </div>

                <div class="form-card">
                    <form action="/admin/projects/add" method="POST" enctype="multipart/form-data">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Project Title <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-heading text-primary"></i></span>
                                    <input type="text" name="title" class="form-control" placeholder="e.g. Full-Stack E-Commerce Application" required>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Technologies / Tech Stack <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-code text-primary"></i></span>
                                    <input type="text" name="technology" class="form-control" placeholder="e.g. Java, Spring Boot, React.js, MySQL" required>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Project Description <span class="text-danger">*</span></label>
                                <textarea name="description" class="form-control" rows="4" placeholder="Detailed description of features, technical challenges, and achievements..." required></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">GitHub Repository Link</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fab fa-github text-dark"></i></span>
                                    <input type="url" name="github" class="form-control" placeholder="https://github.com/khushaliwagh/...">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Live Demo Link</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-globe text-success"></i></span>
                                    <input type="url" name="demo" class="form-control" placeholder="https://...">
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Project Screenshot / Image</label>
                                <div class="upload-area">
                                    <i class="fas fa-cloud-upload-alt fa-2x text-primary mb-2"></i>
                                    <p class="mb-1 fw-semibold">Click to select an image from your device</p>
                                    <small class="text-muted">PNG, JPG, WEBP accepted (leave empty for default screenshot)</small>
                                    <input type="file" name="image" id="imageInput" class="form-control mt-2" accept="image/*">
                                </div>
                                <div class="text-center">
                                    <img id="preview" src="" alt="Preview">
                                </div>
                            </div>

                            <div class="col-12 d-flex justify-content-end gap-3 mt-4">
                                <a href="/admin/projects" class="btn btn-secondary px-4 py-2">Cancel</a>
                                <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm">
                                    <i class="fas fa-save me-2"></i> Save & Publish Project
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Footer Partial -->
            <%- include('../partials/adminFooter') %>

        </div>
    </div>

    <script>
        const imageInput = document.getElementById("imageInput");
        const preview = document.getElementById("preview");

        imageInput.onchange = function () {
            if (imageInput.files && imageInput.files[0]) {
                preview.src = URL.createObjectURL(imageInput.files[0]);
                preview.style.display = "inline-block";
            }
        }
    </script>
</body>

</html>
