<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About / Profile | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body>
    <div class="wrapper">

        <!-- Sidebar Partial -->
        <%- include('../partials/adminSidebar', { active: 'about' }) %>

        <!-- Main -->
        <div class="main">

            <!-- Navbar Partial -->
            <%- include('../partials/adminNavbar') %>

            <div class="container-fluid mt-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-user text-primary me-2"></i> Profile & About Details
                        </h2>
                        <p class="text-muted mb-0">Manage information presented across the portfolio and resume</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="card p-4 text-center shadow-sm border-0">
                            <img src="/images/Firefly1.png" class="rounded-circle mx-auto mb-3 shadow" style="width: 140px; height: 140px; object-fit: cover; border: 4px solid #2563eb;" onerror="this.onerror=null;this.src='/images/k1.png';">
                            <h4 class="fw-bold mb-1"><%= (profile && profile.name) ? profile.name : 'Khushali Wagh' %></h4>
                            <p class="text-primary mb-2"><%= (profile && profile.tagline) ? profile.tagline : 'Full Stack Java Developer' %></p>
                            <span class="badge bg-success-subtle text-success mb-3">Computer Engineering (2026)</span>

                            <div class="text-start mt-3 pt-3 border-top small">
                                <p class="mb-2"><i class="fas fa-map-marker-alt text-danger me-2"></i> Pune, Maharashtra, India</p>
                                <p class="mb-2"><i class="fas fa-envelope text-primary me-2"></i> khushaliwagh17@gmail.com</p>
                                <p class="mb-2"><i class="fas fa-phone text-success me-2"></i> +91 8080235513</p>
                                <p class="mb-2"><i class="fab fa-linkedin text-info me-2"></i> khushaliwagh-7a77042b8</p>
                                <p class="mb-0"><i class="fab fa-github text-dark me-2"></i> github.com/khushaliwagh</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-8">
                        <div class="card p-4 shadow-sm border-0">
                            <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-edit me-1"></i> Edit Profile Information</h5>
                            <form action="/admin/about/update" method="POST">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Full Name</label>
                                        <input type="text" name="name" class="form-control" value="<%= (profile && profile.name) ? profile.name : 'Khushali Wagh' %>" required>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Professional Tagline</label>
                                        <input type="text" name="tagline" class="form-control" value="<%= (profile && profile.tagline) ? profile.tagline : 'Full Stack Java Developer | Software Engineer' %>" required>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-semibold">About / Summary</label>
                                        <textarea name="about_text" class="form-control" rows="5" required><%= (profile && profile.about_text) ? profile.about_text : 'Computer Engineering graduate (2026) and Full Stack Java Developer with a strong foundation in programming fundamentals, Object-Oriented Programming, Data Structures and database concepts. Hands-on experience developing, testing, debugging and maintaining Java and Spring Boot applications, writing SQL queries and managing MySQL databases, and building React.js front ends integrated through REST APIs.' %></textarea>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Email Address</label>
                                        <input type="email" name="email" class="form-control" value="<%= (profile && profile.email) ? profile.email : 'khushaliwagh17@gmail.com' %>">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">LinkedIn Profile URL</label>
                                        <input type="url" name="linkedin" class="form-control" value="<%= (profile && profile.linkedin) ? profile.linkedin : 'https://linkedin.com/in/khushaliwagh-7a77042b8' %>">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">GitHub Profile URL</label>
                                        <input type="url" name="github" class="form-control" value="<%= (profile && profile.github) ? profile.github : 'https://github.com/khushaliwagh' %>">
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Resume / CV File</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control" value="/images/khushaliw.pdf" readonly>
                                            <a href="/images/khushaliw.pdf" target="_blank" class="btn btn-outline-primary">
                                                <i class="fas fa-file-pdf"></i> View
                                            </a>
                                        </div>
                                    </div>

                                    <div class="col-12 text-end mt-3">
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="fas fa-save me-1"></i> Update Profile
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Partial -->
            <%- include('../partials/adminFooter') %>

        </div>
    </div>
</body>

</html>
