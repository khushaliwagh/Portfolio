<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Messages | Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body>
    <div class="wrapper">

        <!-- Sidebar Partial -->
        <%- include('../partials/adminSidebar', { active: 'messages', unreadCount: (typeof unreadCount !== 'undefined' ? unreadCount : 0) }) %>

        <!-- Main -->
        <div class="main">

            <!-- Navbar Partial -->
            <%- include('../partials/adminNavbar', { unreadCount: (typeof unreadCount !== 'undefined' ? unreadCount : 0) }) %>

            <div class="container-fluid mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-envelope-open-text text-primary me-2"></i> Contact Messages
                        </h2>
                        <p class="text-muted mb-0">Messages submitted by visitors via the portfolio contact form</p>
                    </div>
                </div>

                <div class="card p-4 shadow-sm border-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sender</th>
                                    <th>Email Address</th>
                                    <th>Message Snippet</th>
                                    <th>Status</th>
                                    <th>Date Received</th>
                                    <th class="text-center" style="width: 140px;">Actions</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (messages && messages.length > 0) { %>
                                    <% messages.forEach(message => { %>
                                        <tr class="<%= message.status === 'Unread' ? 'table-warning-subtle' : '' %>">
                                            <td>
                                                <strong class="text-dark"><%= message.name %></strong>
                                            </td>

                                            <td>
                                                <a href="mailto:<%= message.email %>" class="text-decoration-none">
                                                    <%= message.email %>
                                                </a>
                                            </td>

                                            <td>
                                                <span class="text-muted" style="display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden;">
                                                    <%= message.message %>
                                                </span>
                                            </td>

                                            <td>
                                                <% if (message.status === 'Unread') { %>
                                                    <span class="badge bg-danger">Unread</span>
                                                <% } else { %>
                                                    <span class="badge bg-success">Read</span>
                                                <% } %>
                                            </td>

                                            <td>
                                                <small class="text-muted"><%= new Date(message.created_at).toLocaleString() %></small>
                                            </td>

                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/admin/messages/view/<%= message.id %>" class="btn btn-primary" title="View Message">
                                                        <i class="fas fa-eye"></i> View
                                                    </a>
                                                    <a href="/admin/messages/delete/<%= message.id %>" class="btn btn-danger" onclick="return confirm('Delete this message?')" title="Delete Message">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="fas fa-inbox fa-3x mb-3 text-secondary"></i>
                                            <p>No contact messages yet.</p>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Footer Partial -->
            <%- include('../partials/adminFooter') %>

        </div>
    </div>
</body>

</html>
